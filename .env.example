# ==============================================================================
# OSHER Açaí Shop — Arquivo de Exemplo de Variáveis de Ambiente
# ==============================================================================
# Este projeto é uma Landing Page / Brandkit estático baseado em HTML5, CSS3 e
# JavaScript puro (Vanilla ES6+). Nenhuma variável de ambiente é obrigatória para
# execução básica.
#
# Caso deseje integrar ferramentas externas ou scripts de build futuramente,
# copie este arquivo para ".env" e configure seus valores:
# ==============================================================================

# Porta para servidor local (opcional)
PORT=3000

# URL Base para produção (exemplo: https://osheracai.com.br ou GitHub Pages)
VITE_SITE_URL=http://localhost:3000

# Chave do Google Analytics 4 (Opcional - Formato: G-XXXXXXXXXX)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# WhatsApp Oficial para atendimento (exemplo com DDD e número)
# CONTACT_WHATSAPP=5561999999999
